OPENAI_API_KEY=sk-...

# Optional overrides
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# whisper-1 / tts-1 work on every project; gpt-4o-mini-transcribe / gpt-4o-mini-tts (voice marin) need access
VOICE_STT_MODEL=whisper-1
VOICE_TTS_MODEL=tts-1
VOICE_TTS_VOICE=alloy
SNACKSTACK_LOG_LEVEL=INFO
